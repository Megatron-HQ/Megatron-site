{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["vendor/megatron/src/renderer/src/*"],
      "@preview/*": ["src/preview/*"]
    }
  },
  "include": [
    "src/preview/**/*.ts",
    "src/preview/**/*.tsx",
    "vendor/megatron/src/**/*.ts",
    "vendor/megatron/src/**/*.tsx"
  ]
}
