{
  "name": "megatron-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The product website for Megatron, a local Claude Code control center.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run preview:check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "git config core.hooksPath .githooks",
    "pre-commit:check": "node .githooks/pre-commit --check",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test .claude/skills/visual-verify/*.test.mjs scripts/ci/*.test.mjs scripts/preview/*.test.mjs src/preview/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.preview.json",
    "preview:check": "node scripts/preview/check-renderer.mjs",
    "preview:sync": "node scripts/preview/sync-renderer.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "verify:visual": "node .claude/skills/visual-verify/verify.mjs",
    "verify:qa": "node scripts/qa/verify.mjs",
    "verify:qa:ci": "node scripts/ci/verify-qa.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide": "1.54.0",
    "lucide-react": "1.30.0",
    "motion": "13.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.3.4"
  }
}
